{
  "name": "apollo",
  "version": "0.1.0",
  "description": "Navegador pessoal com workspaces de sessão isolada",
  "main": "build/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "start": "node scripts/build.mjs && electron .",
    "diagnose": "node scripts/build.mjs && node scripts/diagnose.mjs",
    "dist:linux": "node scripts/build.mjs --prod && electron-builder --linux --publish never",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^24.19.2",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/davidosanjoss/apollo-releases",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidosanjoss/apollo.git"
  },
  "build": {
    "appId": "io.github.davidosanjoss.apollo",
    "productName": "Apollo",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network",
      "executableName": "apollo"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davidosanjoss",
        "repo": "apollo-releases",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
